<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Browse past Winner Signal editions from SafeTracker: Sweepstakes.">
  <title>Winner Signal Newsletter Archive | SafeTracker: Sweepstakes</title>
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">
  <link rel="canonical" href="https://sweeps.safetrackerhub.com/newsletter/">
  <link rel="icon" type="image/svg+xml" href="../assets/sweeps-shield.svg">
  <link rel="stylesheet" href="../assets/sweeps-site.css?v=20260807-shared-header-logo">
</head>
<body>
  <header class="site-header review-site-header">
    <div class="review-shell review-masthead">
      <a class="review-brand" href="../index.html">← SafeTracker: Sweepstakes</a>
      <span>Winner Signal by SafeTracker · Newsletter archive</span>
    </div>
  </header>
  <main class="review-shell guide-archive">
    <header class="guide-archive-hero">
      <p class="section-kicker">Source-linked winner updates</p>
      <h1>Winner Signal archive</h1>
      <p><strong>Winner Signal by SafeTracker: Sweepstakes</strong> preserves every sent edition here after it is accepted for delivery. We publish no empty editions and link every reported win to its monitored source.</p>
    </header>
    <aside class="newsletter-card newsletter-archive-signup" aria-labelledby="newsletter-archive-signup-heading">
      <p class="section-kicker">Free winner alerts</p>
      <h2 id="newsletter-archive-signup-heading">Get Winner Signal</h2>
      <p>Receive source-linked winner reports only when something new is found.</p>
      <div id="winner-signal-newsletter-archive" data-winner-signal-signup data-variant="card"></div>
      <span class="newsletter-privacy">Double opt-in. No empty emails. No winner claims. Unsubscribe anytime.</span>
    </aside>
    <section class="guide-archive-list" aria-labelledby="editions-heading">
      <div class="guide-archive-heading">
        <div><p class="section-kicker">Past emails</p><h2 id="editions-heading">All editions</h2></div>
        <p>{{ editions|length }} edition{% if editions|length != 1 %}s{% endif %}</p>
      </div>
      <div class="guide-archive-grid">
        {% for edition in editions %}
        <article>
          <p class="guide-archive-meta">{{ edition.display_date }} · {{ edition.report_count }} report{% if edition.report_count != 1 %}s{% endif %}</p>
          <h3>{{ edition.subject }}</h3>
          <p>{{ edition.source_count }} monitored source{% if edition.source_count != 1 %}s{% endif %} contributed to this edition.</p>
          <a href="{{ edition.slug }}.html">Read this edition →</a>
        </article>
        {% else %}
        <article>
          <p class="guide-archive-meta">Archive ready</p>
          <h3>No sent editions yet</h3>
          <p>The first edition will appear here automatically after successful newsletter scheduling.</p>
        </article>
        {% endfor %}
      </div>
    </section>
  </main>
  <script src="../assets/winner-signal-config.js"></script>
  <script src="../assets/winner-signal-signup.js"></script>
  <script src="../assets/monetization.js?v=20260726-2"></script>
</body>
</html>
