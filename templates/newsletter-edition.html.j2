<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ edition.subject }} from Winner Signal by SafeTracker: Sweepstakes.">
  <title>{{ edition.subject }} | Winner Signal</title>
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">
  <link rel="canonical" href="https://sweeps.safetrackerhub.com/newsletter/{{ edition.slug }}.html">
  <link rel="icon" type="image/svg+xml" href="../assets/sweeps-shield.svg">
  <link rel="stylesheet" href="../assets/sweeps-site.css?v=20260807-shared-header-logo">
</head>
<body>
  <header class="site-header review-site-header">
    <div class="review-shell review-masthead">
      <a class="review-brand" href="index.html">← Winner Signal archive</a>
      <span>Winner Signal by SafeTracker · {{ edition.display_date }}</span>
    </div>
  </header>
  <main class="review-shell winners-page">
    <section class="winners-hero">
      <div>
        <p class="section-kicker">SafeTracker: Sweepstakes · Winner Signal</p>
        <h1>{{ edition.subject }}</h1>
        <p class="winners-intro">{{ edition.report_count }} source-linked winner report{% if edition.report_count != 1 %}s{% endif %} from {{ edition.source_count }} monitored source{% if edition.source_count != 1 %}s{% endif %}.</p>
      </div>
    </section>
    <section class="winner-list" aria-label="Winner reports in this edition">
      {% for report in edition.reports %}
      <article class="winner-card">
        <p class="section-kicker">{% if report.source_type == 'operator_announcement' %}Official operator announcement{% else %}Community-reported win{% endif %}</p>
        <h2>{{ report.winner_name }}</h2>
        <dl class="winner-facts">
          <div><dt>Prize</dt><dd>{{ report.prize }}</dd></div>
          <div><dt>Contest</dt><dd>{{ report.promotion_name }}</dd></div>
          <div><dt>Source</dt><dd>{{ report.source_name }}</dd></div>
        </dl>
        <a class="winner-source" href="{{ report.source_url }}" target="_blank" rel="noopener">View original report →</a>
      </article>
      {% endfor %}
    </section>
    <p class="source-note"><strong>Safety note:</strong> A winner report is not a request for payment. Legitimate prizes never require gift cards, wire transfers, or processing fees.</p>
    <aside class="newsletter-card newsletter-archive-signup" aria-labelledby="edition-signup-heading">
      <p class="section-kicker">Free winner alerts</p>
      <h2 id="edition-signup-heading">Get the next Winner Signal</h2>
      <p>Receive source-linked winner reports only when something new is found.</p>
      <div id="winner-signal-edition-signup" data-winner-signal-signup data-variant="card"></div>
      <span class="newsletter-privacy">Double opt-in. No empty emails. No winner claims. Unsubscribe anytime.</span>
    </aside>
  </main>
  <script src="../assets/winner-signal-config.js"></script>
  <script src="../assets/winner-signal-signup.js"></script>
  <script src="../assets/monetization.js?v=20260726-2"></script>
</body>
</html>
